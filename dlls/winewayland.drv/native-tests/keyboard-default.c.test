struct request { int operation; DWORD tid; uintptr_t layout; };
struct reply { uintptr_t layout; };
static struct request *req;
static struct reply *reply;
enum { request_get_thread_layout, request_set_thread_layout, request_set_process_layout };
static int server_error;
static struct thread *get_thread_from_id(DWORD id)
{
    unsigned int i;
    for (i = 0; i < 4; i++) if (threads[i].id == id) return &threads[i];
    server_error = 1;
    return NULL;
}
static void release_object(struct thread *thread) {}

/* SERVER_FUNCTIONS */

static int call_server(struct request *request, struct reply *response)
{
    server_calls++;
    if (server_failure) return 1;
    req = request;
    reply = response;
    server_error = 0;
    if (request->operation == request_get_thread_layout) server_get_thread_layout();
    else if (request->operation == request_set_thread_layout) server_set_thread_layout();
    else server_set_process_layout();
    req = NULL;
    reply = NULL;
    return server_error;
}
#define SERVER_START_REQ(name) do { \
    struct request request_ = {.operation = request_##name}; \
    struct reply reply_ = {0}; \
    struct request *req = &request_; \
    struct reply *reply = &reply_; (void)reply;
#define SERVER_END_REQ } while (0)
#define wine_server_call(request) call_server((request), reply)
#define wine_server_call_err(request) call_server((request), reply)
#define wine_server_get_ptr(value) ((void *)(uintptr_t)(value))
#define wine_server_client_ptr(value) ((uintptr_t)(value))

