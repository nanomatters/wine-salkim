};
static struct list xkb_layouts = LIST_INIT(xkb_layouts);
static pthread_mutex_t xkb_layouts_mutex = PTHREAD_MUTEX_INITIALIZER;
static HKL keyboard_hkl;
static xkb_layout_index_t keyboard_group;
#define XKB_LAYOUT_INVALID ((xkb_layout_index_t)-1)
static HWND focused_hwnd;
static HKL posted_hkl;
static struct layout layouts[2];
static KBDTABLES kbdus_tables;
static USHORT scan_maps[2][0x2d];
static WCHAR key_z[] = {'Z',0}, key_y[] = {'Y',0};
static VSC_LPWSTR german_names[] = {{0x15,key_z},{0x2c,key_y},{0,NULL}};
static VSC_LPWSTR us_names[] = {{0x15,key_y},{0x2c,key_z},{0,NULL}};
static VSC_LPWSTR empty_names[] = {{0,NULL}};
static VK_TO_WCHARS1 letter_chars[] = {{'Y',0,{'y'}},{'Z',0,{'z'}},{0,0,{0}}};
static VK_TO_WCHAR_TABLE char_table[] = {{letter_chars,1},{NULL,0}};
static VK_TO_BIT modifier_bits[] = {{0,0}};
static MODIFIERS modifiers = {modifier_bits,0,{0}};
static void xkb_layout_addref(struct layout *layout) { layout->refs++; }
static void xkb_layout_release(struct layout *layout) { assert(layout->refs); layout->refs--; }
#define CONTAINING_RECORD(address,type,field) ((type *)((char *)(address) - offsetof(type,field)))
static HWND wayland_keyboard_get_focused_hwnd(void) { return focused_hwnd; }
static HWND NtUserGetForegroundWindow(void) { return focused_hwnd; }
static HWND wayland_keyboard_get_input_hwnd(HWND hwnd, HWND foreground) { return hwnd; }
static BOOL NtUserPostMessage(HWND hwnd, UINT message, uintptr_t wparam, LPARAM lparam)
{
    assert(hwnd == focused_hwnd && message == WM_INPUTLANGCHANGEREQUEST && !wparam);
    posted_hkl = (HKL)lparam;
    /* Default publication must already be visible before notifying the window. */
    if (!server_failure)
    {
        assert(current->process->client_default == posted_hkl);
        assert(current->process->default_layout == (uintptr_t)posted_hkl);
    }
    posts++;
    return TRUE;
}
static BOOL check_deinit_lock;
static void assert_keyboard_mutex_unlocked(void);
static BOOL NtUserSetDefaultKeyboardLayout(HKL layout)
{
    if (check_deinit_lock) assert_keyboard_mutex_unlocked();
    return set_default_keyboard_layout(layout);
}

struct wl_keyboard { UINT unused; } wl_keyboard;
struct xkb_context { UINT unused; } xkb_context;
struct rxkb_context { UINT unused; } rxkb_context_object;
static struct rxkb_context *rxkb_context;
struct xkb_state { UINT group; } xkb_state;
struct wayland_keyboard
{
    pthread_mutex_t mutex;
    HWND focused_hwnd;
    struct wl_keyboard *wl_keyboard;
    struct xkb_context *xkb_context;
    struct xkb_state *xkb_state;
};
static struct
{
    LONG input_serial;
    struct wayland_keyboard keyboard;
} process_wayland = {.keyboard.mutex = PTHREAD_MUTEX_INITIALIZER};
static unsigned int keyboard_destroyed, context_released, state_released, rules_released, focus_released;
static void assert_keyboard_mutex_unlocked(void)
{
    assert(!pthread_mutex_trylock(&process_wayland.keyboard.mutex));
    pthread_mutex_unlock(&process_wayland.keyboard.mutex);
}
static void wl_keyboard_destroy(struct wl_keyboard *keyboard)
{
    assert(keyboard == &wl_keyboard);
    keyboard_destroyed++;
}
static void xkb_context_unref(struct xkb_context *context)
{
    assert(context == &xkb_context);
    context_released++;
}
static void xkb_state_unref(struct xkb_state *state)
{
    assert(state == &xkb_state);
    state_released++;
}
static void rxkb_context_unref(struct rxkb_context *context)
{
    assert(context == &rxkb_context_object);
    rules_released++;
}
static void wayland_external_input_set_keyboard_focus(BOOL focused)
{
    assert_keyboard_mutex_unlocked();
    assert(!focused && !keyboard_hkl && keyboard_group == XKB_LAYOUT_INVALID);
    assert(!processes[0].default_layout && !processes[0].client_default);
    focus_released++;
}
static void xkb_state_update_mask(struct xkb_state *state, UINT depressed, UINT latched,
                                  UINT locked, UINT base, UINT latch, UINT group)
{
    state->group = group;
}

/* WAYLAND_FUNCTIONS */

/* TRANSLATION_FUNCTIONS */

static void select_thread(unsigned int index) { assert(index < 4); current = &threads[index]; }
static void expect_name(const char *expected)
{
    WCHAR name[KL_NAMELENGTH];
    unsigned int i;
    assert(NtUserGetKeyboardLayoutName(name));
    for (i = 0; i < KL_NAMELENGTH; i++) assert(name[i] == (unsigned char)expected[i]);
}
static void reset(void)
{
    unsigned int i;
    memset(processes, 0, sizeof(processes));
    memset(threads, 0, sizeof(threads));
    for (i = 0; i < 2; i++) processes[i].locale = 0x0409;
    for (i = 0; i < 4; i++)
    {
        threads[i].id = 0x100 + i;
        threads[i].process = &processes[i / 2];
    }
    select_thread(0);
    server_calls = registry_enumerations = posts = 0;
    server_failure = activation_failure = locale_failure = 0;
    driver_default = NULL;
    last_error = 0;
    keyboard_hkl = posted_hkl = NULL;
    keyboard_group = XKB_LAYOUT_INVALID;
    ime_hwnd = NULL;
    ime_selected = NULL;
    ime_previous = NULL;
    ime_messages = 0;
    focus_hwnd = NULL;
    lang_change_hkl = NULL;
    lang_changes = 0;
    assert(!imc_handles);
    handle_failure = FALSE;
    check_deinit_lock = FALSE;
    keyboard_destroyed = context_released = state_released = rules_released = focus_released = 0;
    process_wayland.keyboard.focused_hwnd = NULL;
    process_wayland.keyboard.wl_keyboard = NULL;
    process_wayland.keyboard.xkb_context = NULL;
    process_wayland.keyboard.xkb_state = &xkb_state;
    rxkb_context = NULL;
    focused_hwnd = NULL;
    list_init(&xkb_layouts);
    memset(layouts, 0, sizeof(layouts));
    for (i = 0; i < 2; i++)
    {
        layouts[i].xkb_group = i;
        layouts[i].lang = i ? 0x0409 : 0x0407;
        layouts[i].refs = 1;
        layouts[i].tables.identity = layouts[i].lang;
        memset(scan_maps[i], 0, sizeof(scan_maps[i]));
        scan_maps[i][0x15] = i ? 'Y' : 'Z';
        scan_maps[i][0x2c] = i ? 'Z' : 'Y';
        layouts[i].tables.pusVSCtoVK = scan_maps[i];
        layouts[i].tables.bMaxVSCtoVK = ARRAY_SIZE(scan_maps[i]) - 1;
        layouts[i].tables.pKeyNames = i ? us_names : german_names;
        layouts[i].tables.pKeyNamesExt = empty_names;
        layouts[i].tables.pVkToWcharTable = char_table;
        layouts[i].tables.pCharModifiers = &modifiers;
        list_add_tail(&xkb_layouts, &layouts[i].entry);
    }
    kbdus_tables = layouts[1].tables;
}

static void test_default_publication(void)
{
    const HKL us = (HKL)0x04090409, de = (HKL)0x04070409;
    unsigned int calls, enumerations;
    reset();

    /* Startup may ask for a layout name before a Wayland keymap exists. */
    assert(NtUserGetKeyboardLayout(0) == us);
    expect_name("00000409");
    assert(!current->info.kbd_layout && !current->layout);

    set_default_keyboard_layout(de);
    assert(processes[0].default_layout == (uintptr_t)de);
    /* Setting a process default does not redefine the thread request's tid=0. */
    SERVER_START_REQ(set_thread_layout)
    {
        req->tid = 0;
        req->layout = (uintptr_t)us;
        assert(wine_server_call(req));
    }
    SERVER_END_REQ;
    assert(processes[0].default_layout == (uintptr_t)de);
    assert(!current->info.kbd_layout && !current->layout);
    assert(NtUserGetKeyboardLayout(0) == de);
    expect_name("00000407");
    enumerations = registry_enumerations;
    expect_name("00000407");
    assert(registry_enumerations == enumerations);

    /* Current-thread/default lookups remain a local operation. */
    calls = server_calls;
    assert(NtUserGetKeyboardLayout(GetCurrentThreadId()) == de);
    assert(NtUserGetKeyboardLayout(0) == de);
    assert(server_calls == calls);

    assert(NtUserGetKeyboardLayout(threads[1].id) == de);
    select_thread(1);
    assert(NtUserGetKeyboardLayout(0) == de);
    expect_name("00000407");

    set_default_keyboard_layout(us);
    assert(NtUserGetKeyboardLayout(0) == us);
    expect_name("00000409");
    select_thread(0);
    assert(NtUserGetKeyboardLayout(0) == us);
    expect_name("00000409");

    last_error = 0;
    assert(!NtUserGetKeyboardLayoutName(NULL));
    assert(last_error == ERROR_NOACCESS);

    /* Failed driver initialization withdraws any host default already sent. */
    assert(set_default_keyboard_layout(de));
    expect_name("00000407");
    assert(set_default_keyboard_layout(NULL));
    assert(!processes[0].default_layout && !processes[0].client_default);
    assert(NtUserGetKeyboardLayout(0) == us);
    assert(NtUserGetKeyboardLayout(threads[1].id) == us);
    expect_name("00000409");
}

static void test_explicit_layouts(void)
{
    const HKL us = (HKL)0x04090409, de = (HKL)0x04070409;
    reset();
    set_default_keyboard_layout(de);

    /* Selecting the current default must still create an explicit selection. */
    assert(NtUserActivateKeyboardLayout(de, 0) == de);
    assert(current->info.kbd_layout == de && current->layout == (uintptr_t)de);
    set_default_keyboard_layout(us);
    assert(NtUserGetKeyboardLayout(0) == de);
    expect_name("00000407");
    assert(NtUserGetKeyboardLayout(threads[1].id) == us);

    select_thread(1);
    assert(NtUserGetKeyboardLayout(threads[0].id) == de);
    assert(NtUserActivateKeyboardLayout(de, 0) == us);
    assert(NtUserActivateKeyboardLayout(us, 0) == de);
    set_default_keyboard_layout(de);
    assert(NtUserGetKeyboardLayout(0) == us);
    expect_name("00000409");
    activation_failure = 1;
    assert(!NtUserActivateKeyboardLayout(de, 0));
    assert(NtUserGetKeyboardLayout(0) == us);
    assert(set_default_keyboard_layout(NULL));
    assert(NtUserGetKeyboardLayout(threads[0].id) == de);
    assert(NtUserGetKeyboardLayout(0) == us);
}

static void test_activation_snapshot_and_ime(void)
{
    const HKL us = (HKL)0x04090409, de = (HKL)0x04070409;

    reset();
    driver_default = de;
    assert(NtUserGetKeyboardLayout(0) == us);
    assert(NtUserActivateKeyboardLayout(de, 0) == us);
    assert(NtUserGetKeyboardLayout(0) == de);

    reset();
    ime_hwnd = (HWND)0x456;
    ime_selected = us;
    assert(set_default_keyboard_layout(de));
    assert(NtUserActivateKeyboardLayout(de, 0) == de);
    assert(ime_selected == de && ime_messages == 2);
    assert(set_default_keyboard_layout(us));
    assert(NtUserGetKeyboardLayout(0) == de);

}

static void test_lazy_activation_placeholder(void)
{
    const HKL us = (HKL)0x04090409, de = (HKL)0x04070409;
    HKL requested;
    WCHAR name[8];

    /* A first driver load replaces a locale placeholder with a real layout. */
    reset();
    list_remove(&layouts[1].entry);
    focus_hwnd = (HWND)0x345;
    requested = NtUserGetKeyboardLayout(0);
    driver_default = de;
    assert(requested == us && NtUserActivateKeyboardLayout(requested, 0) == us);
    assert(!current->info.kbd_layout && !current->layout && !lang_changes && !ime_messages);
    assert(NtUserGetKeyboardLayout(0) == de && NtUserGetKeyboardLayout(threads[1].id) == de);
    expect_name("00000407");
    assert(NtUserMapVirtualKeyEx(0x15, MAPVK_VSC_TO_VK, NtUserGetKeyboardLayout(0)) == 'Z');
    assert(NtUserGetKeyNameText(0x15 << 16, name, ARRAY_SIZE(name)) == 1 && name[0] == 'Z');
    assert(layouts[0].refs == 1);

    /* The same request must pin when US is actually configured. */
    reset();
    driver_default = de;
    assert(NtUserActivateKeyboardLayout(NtUserGetKeyboardLayout(0), 0) == us);
    assert(current->info.kbd_layout == us && current->layout == (uintptr_t)us);
    assert(NtUserGetKeyboardLayout(0) == us && layouts[1].refs == 1);

    /* Legacy drivers need not expose tables or publish a host default. */
    reset();
    list_init(&xkb_layouts);
    assert(NtUserActivateKeyboardLayout(NtUserGetKeyboardLayout(0), 0) == us);
    assert(current->info.kbd_layout == us && current->layout == (uintptr_t)us);

    /* A later host switch cannot discard an explicit selection of US. */
    reset();
    list_remove(&layouts[1].entry);
    assert(set_default_keyboard_layout(us));
    driver_default = de;
    assert(NtUserActivateKeyboardLayout(us, 0) == us);
    assert(current->info.kbd_layout == us && current->layout == (uintptr_t)us);
    assert(NtUserGetKeyboardLayout(0) == us);

    reset();
    list_remove(&layouts[1].entry);
    assert(set_default_keyboard_layout(de));
    assert(NtUserActivateKeyboardLayout(us, 0) == de);
    assert(NtUserGetKeyboardLayout(0) == us && current->info.kbd_layout == us);
}

static void test_cross_process_layouts(void)
{
    const HKL us = (HKL)0x04090409, de = (HKL)0x04070409;
    reset();
    set_default_keyboard_layout(de);
    select_thread(2);
    set_default_keyboard_layout(us);
    assert(NtUserGetKeyboardLayout(threads[0].id) == de);
    assert(NtUserGetKeyboardLayout(threads[1].id) == de);
    assert(NtUserGetKeyboardLayout(0) == us);
    assert(NtUserActivateKeyboardLayout(de, 0) == us);
    select_thread(0);
    assert(NtUserGetKeyboardLayout(threads[2].id) == de);
    assert(NtUserGetKeyboardLayout(threads[3].id) == us);
    set_default_keyboard_layout(us);
    select_thread(2);
    assert(NtUserGetKeyboardLayout(threads[0].id) == us);
    assert(NtUserGetKeyboardLayout(0) == de);
}

static void test_wayland_publication(void)
{
    const HKL us = (HKL)0x04090409, de = (HKL)0x04070409;
    const KBDTABLES *tables;
    unsigned int calls;
    reset();
    expect_name("00000409");
    set_current_xkb_group(0);
    assert(keyboard_hkl == de && !posts);
    assert(NtUserGetKeyboardLayout(0) == de);
    expect_name("00000407");

    focused_hwnd = (HWND)0x234;
    set_current_xkb_group(1);
    assert(keyboard_hkl == us && posts == 1 && posted_hkl == us);
    calls = server_calls;
    set_current_xkb_group(1);
    assert(posts == 1 && server_calls == calls);
    set_current_xkb_group(99);
    assert(keyboard_hkl == us && posts == 1 && server_calls == calls);

    /* Explicit translation requests continue resolving their own layout. */
    tables = WAYLAND_KbdLayerDescriptor(de);
    assert(tables == &layouts[0].tables && layouts[0].refs == 2);
    set_current_xkb_group(0);
    assert(posts == 2 && posted_hkl == de);
    assert(tables->identity == 0x0407);
    WAYLAND_ReleaseKbdTables(tables);
    assert(layouts[0].refs == 1);
    tables = WAYLAND_KbdLayerDescriptor(us);
    assert(tables == &layouts[1].tables);
    WAYLAND_ReleaseKbdTables(tables);
    assert(!WAYLAND_KbdLayerDescriptor((HKL)0x040c0409));
}

static void test_publication_failure(void)
{
    const HKL us = (HKL)0x04090409, de = (HKL)0x04070409;
    reset();
    server_failure = 1;
    assert(!set_default_keyboard_layout(de));
    assert(!processes[0].default_layout && !processes[0].client_default);
    assert(NtUserGetKeyboardLayout(0) == us);

    focused_hwnd = (HWND)0x234;
    set_current_xkb_group(0);
    assert(keyboard_hkl == de && posts == 1 && posted_hkl == de);
    assert(NtUserGetKeyboardLayout(0) == us);
    server_failure = 0;
    set_current_xkb_group(0);
    assert(keyboard_hkl == de && posts == 1);
    expect_name("00000407");

    server_failure = 1;
    set_current_xkb_group(1);
    assert(keyboard_hkl == us && posts == 2 && posted_hkl == us);
    assert(processes[0].default_layout == (uintptr_t)de);
    assert(NtUserGetKeyboardLayout(0) == de);
    expect_name("00000407");
    server_failure = 0;
    set_current_xkb_group(1);
    assert(keyboard_hkl == us && posts == 2);
    assert(NtUserGetKeyboardLayout(threads[1].id) == us);
}

static void test_initial_group(void)
{
    const HKL de = (HKL)0x04070409, us = (HKL)0x04090409;
    unsigned int calls;

    reset();
    reset_keyboard_layout(2);
    assert(!keyboard_hkl && !server_calls);
    /* Compositors may report the actual group without keyboard focus. */
    keyboard_handle_modifiers(NULL, NULL, 1, 0, 0, 0, 1);
    assert(keyboard_hkl == us && NtUserGetKeyboardLayout(0) == us && !posts);
    assert(xkb_state.group == 1);
    focused_hwnd = (HWND)0x234;
    calls = server_calls;
    reset_keyboard_layout(2);
    assert(keyboard_hkl == us && processes[0].client_default == us && !posts);
    assert(server_calls == calls);
    assert(NtUserGetKeyboardLayout(0) == us);
    focused_hwnd = NULL;
    keyboard_group = XKB_LAYOUT_INVALID; /* A different map has no reported group yet. */
    reset_keyboard_layout(1);
    assert(keyboard_hkl == de && NtUserGetKeyboardLayout(0) == de && !posts);
    process_wayland.keyboard.xkb_state = NULL;
    calls = server_calls;
    keyboard_handle_modifiers(NULL, NULL, 2, 0, 0, 0, 1);
    assert(keyboard_hkl == de && server_calls == calls);
    locale_failure = 1;
    set_current_xkb_group(1);
    assert(keyboard_hkl == de && server_calls == calls);
    wayland_keyboard_clear_layout();
    assert(!keyboard_hkl && keyboard_group == XKB_LAYOUT_INVALID);
    assert(!processes[0].default_layout && !processes[0].client_default);
}

static void test_keyboard_seat_lifecycle(void)
{
    struct wayland_keyboard *keyboard = &process_wayland.keyboard;
    const HKL de = (HKL)0x04070409, us = (HKL)0x04090409;
    unsigned int calls;

    reset();
    keyboard->focused_hwnd = (HWND)0x234;
    keyboard->wl_keyboard = &wl_keyboard;
    keyboard->xkb_context = &xkb_context;
    rxkb_context = &rxkb_context_object;
    keyboard_handle_modifiers(NULL, NULL, 1, 0, 0, 0, 1);
    assert(keyboard_group == 1 && keyboard_hkl == us);
    assert(processes[0].client_default == us && processes[0].default_layout == (uintptr_t)us);

    check_deinit_lock = TRUE;
    wayland_keyboard_deinit();
    assert(!keyboard->focused_hwnd && !keyboard->wl_keyboard && !keyboard->xkb_context && !keyboard->xkb_state);
    assert(!rxkb_context && !keyboard_hkl && keyboard_group == XKB_LAYOUT_INVALID);
    assert(!processes[0].client_default && !processes[0].default_layout);
    assert(keyboard_destroyed == 1 && context_released == 1 && state_released == 1);
    assert(rules_released == 1 && focus_released == 1);
    calls = server_calls;
    wayland_keyboard_deinit();
    assert(server_calls == calls);
    assert(keyboard_destroyed == 1 && context_released == 1 && state_released == 1);
    assert(rules_released == 1 && focus_released == 1);
    check_deinit_lock = FALSE;

    /* A new keyboard's map may number its groups differently. It must wait
     * for its own modifiers event rather than reuse the departed seat's group. */
    layouts[0].xkb_group = 1;
    layouts[1].xkb_group = 0;
    keyboard->xkb_state = &xkb_state;
    reset_keyboard_layout(2);
    assert(keyboard_group == XKB_LAYOUT_INVALID && !keyboard_hkl);
    assert(!processes[0].client_default && !processes[0].default_layout);
    keyboard_handle_modifiers(NULL, NULL, 2, 0, 0, 0, 1);
    assert(keyboard_group == 1 && keyboard_hkl == de);
    assert(NtUserGetKeyboardLayout(0) == de);
}

static void test_notification_baseline(void)
{
    const HKL us = (HKL)0x04090409, de = (HKL)0x04070409;

    reset();
    focus_hwnd = focused_hwnd = (HWND)0x345;
    assert(NtUserGetKeyboardLayout(0) == us);
    set_current_xkb_group(0);
    assert(posted_hkl == de && NtUserGetKeyboardLayout(threads[1].id) == de);
    /* An unrelated query between publication and activation must not suppress
     * the first WM_INPUTLANGCHANGE or replace the activation return value. */
    assert(NtUserGetKeyboardLayout(0) == de);
    assert(NtUserActivateKeyboardLayout(de, 0) == de);
    assert(lang_changes == 1 && lang_change_hkl == de && current->info.kbd_layout == de);
    assert(NtUserActivateKeyboardLayout(de, 0) == de && lang_changes == 1);

    select_thread(1);
    assert(NtUserGetKeyboardLayout(0) == de);
    assert(NtUserActivateKeyboardLayout(de, 0) == de);
    assert(lang_changes == 2 && current->info.kbd_layout == de);
    set_current_xkb_group(1);
    assert(NtUserGetKeyboardLayout(0) == de);
    assert(NtUserActivateKeyboardLayout(us, 0) == de);
    assert(lang_changes == 3 && lang_change_hkl == us);

    reset();
    focus_hwnd = (HWND)0x345;
    assert(NtUserActivateKeyboardLayout(us, 0) == us);
    assert(current->info.kbd_layout == us && current->layout == (uintptr_t)us);
    assert(lang_changes == 1 && server_calls == 1);
    set_default_keyboard_layout(de);
    assert(NtUserGetKeyboardLayout(threads[1].id) == de);
    assert(NtUserActivateKeyboardLayout(de, 0) == us);
    assert(lang_changes == 2 && current->info.kbd_layout == de);
    assert(NtUserGetKeyboardLayout(0) == de);
    assert(NtUserActivateKeyboardLayout(de, 0) == de && lang_changes == 2);
}

static void test_input_context_layout(void)
{
    const HKL us = (HKL)0x04090409, de = (HKL)0x04070409;
    HIMC imc, second;
    unsigned int calls;

    reset();
    /* A real client context created before focus must not pin the locale HKL. */
    calls = server_calls;
    imc = NtUserCreateInputContext(1);
    assert(imc && ((struct imc *)imc)->client_ptr == 1);
    assert(!current->info.kbd_layout && !current->layout && server_calls == calls);
    expect_name("00000409");
    set_default_keyboard_layout(de);
    assert(NtUserGetKeyboardLayout(0) == de);
    expect_name("00000407");
    set_default_keyboard_layout(us);
    assert(NtUserGetKeyboardLayout(0) == us);
    assert(NtUserDestroyInputContext(imc));

    /* Attaching a client to a placeholder does not activate a layout either. */
    reset();
    imc = NtUserCreateInputContext(0);
    assert(imc && !current->info.kbd_layout);
    calls = server_calls;
    assert(NtUserUpdateInputContext(imc, NtUserInputContextClientPtr, 1));
    assert(!current->info.kbd_layout && !current->layout && server_calls == calls);
    assert(((struct imc *)imc)->client_ptr == 1);
    set_default_keyboard_layout(de);
    assert(NtUserGetKeyboardLayout(0) == de);
    assert(NtUserDestroyInputContext(imc));

    /* Another thread attaching the client must not select either thread's HKL. */
    reset();
    imc = NtUserCreateInputContext(0);
    assert(imc && ((struct imc *)imc)->thread_id == threads[0].id);
    select_thread(1);
    calls = server_calls;
    assert(NtUserUpdateInputContext(imc, NtUserInputContextClientPtr, 1));
    assert(server_calls == calls && ((struct imc *)imc)->thread_id == threads[0].id);
    assert(!threads[0].info.kbd_layout && !threads[0].layout);
    assert(!threads[1].info.kbd_layout && !threads[1].layout);
    set_default_keyboard_layout(de);
    assert(NtUserGetKeyboardLayout(0) == de);
    assert(NtUserGetKeyboardLayout(threads[0].id) == de);
    select_thread(0);
    assert(NtUserGetKeyboardLayout(0) == de);
    assert(NtUserDestroyInputContext(imc));

    /* Explicit activation continues to pin a layout, independently of IMCs. */
    assert(NtUserActivateKeyboardLayout(de, 0) == de);
    second = NtUserCreateInputContext(2);
    assert(second && NtUserUpdateInputContext(second, NtUserInputContextClientPtr, 3));
    set_default_keyboard_layout(us);
    assert(NtUserGetKeyboardLayout(0) == de);
    assert(NtUserGetKeyboardLayout(threads[1].id) == us);
    assert(NtUserDestroyInputContext(second));

    /* Context lifetime and client attachment no longer depend on publication. */
    reset();
    server_failure = 1;
    calls = server_calls;
    second = NtUserCreateInputContext(1);
    assert(second && !current->info.kbd_layout && !current->layout);
    imc = NtUserCreateInputContext(0);
    assert(imc && NtUserUpdateInputContext(imc, NtUserInputContextClientPtr, 1));
    assert(((struct imc *)imc)->client_ptr == 1 && server_calls == calls);
    assert(!current->info.kbd_layout && !current->layout);
    assert(NtUserDestroyInputContext(imc));
    assert(NtUserDestroyInputContext(second));
}

static void test_worker_translations(void)
{
    const HKL us = (HKL)0x04090409, de = (HKL)0x04070409;
    WCHAR name[8];
    BYTE state[256] = {0};
    UINT vkey;
    reset();
    set_current_xkb_group(0);
    select_thread(1);
    assert(NtUserMapVirtualKeyEx(0x15, MAPVK_VSC_TO_VK, NtUserGetKeyboardLayout(0)) == 'Z');
    assert(NtUserMapVirtualKeyEx(0x2c, MAPVK_VSC_TO_VK, NtUserGetKeyboardLayout(0)) == 'Y');
    assert(NtUserGetKeyNameText(0x15 << 16, name, ARRAY_SIZE(name)) == 1);
    assert(name[0] == 'Z' && !name[1]);
    assert(NtUserGetKeyNameText(0x2c << 16, name, ARRAY_SIZE(name)) == 1);
    assert(name[0] == 'Y' && !name[1]);
    vkey = NtUserMapVirtualKeyEx(0x15, MAPVK_VSC_TO_VK, NtUserGetKeyboardLayout(0));
    assert(NtUserToUnicodeEx(vkey, 0x15, state, name, ARRAY_SIZE(name), 0,
                             NtUserGetKeyboardLayout(0)) == 1);
    assert(name[0] == 'z' && !name[1]);

    assert(NtUserActivateKeyboardLayout(us, 0) == de);
    assert(NtUserMapVirtualKeyEx(0x15, MAPVK_VSC_TO_VK, NtUserGetKeyboardLayout(0)) == 'Y');
    assert(NtUserGetKeyNameText(0x15 << 16, name, ARRAY_SIZE(name)) == 1);
    assert(name[0] == 'Y' && !name[1]);
    vkey = NtUserMapVirtualKeyEx(0x15, MAPVK_VSC_TO_VK, NtUserGetKeyboardLayout(0));
    assert(NtUserToUnicodeEx(vkey, 0x15, state, name, ARRAY_SIZE(name), 0,
                             NtUserGetKeyboardLayout(0)) == 1);
    assert(name[0] == 'y' && !name[1]);
    assert(NtUserMapVirtualKeyEx(0x15, MAPVK_VSC_TO_VK, de) == 'Z');
    assert(layouts[0].refs == 1 && layouts[1].refs == 1);
}

static void test_worker_variant_translation(void)
{
    const KBDTABLES *tables;
    HKL layout;
    WCHAR name[8];

    reset();
    layouts[0].layout_id = 0x123;
    layout = get_layout_hkl(&layouts[0], processes[0].locale);
    assert(set_current_xkb_group(0));
    select_thread(1);
    assert(NtUserGetKeyboardLayout(0) == layout);
    tables = WAYLAND_KbdLayerDescriptor(NtUserGetKeyboardLayout(0));
    assert(tables == &layouts[0].tables);
    WAYLAND_ReleaseKbdTables(tables);
    assert(NtUserMapVirtualKeyEx(0x15, MAPVK_VSC_TO_VK, NtUserGetKeyboardLayout(0)) == 'Z');
    assert(NtUserGetKeyNameText(0x15 << 16, name, ARRAY_SIZE(name)) == 1);
    assert(name[0] == 'Z' && !name[1]);
    assert(layouts[0].refs == 1);
}

int main(void)
{
    test_default_publication();
    test_explicit_layouts();
    test_activation_snapshot_and_ime();
    test_lazy_activation_placeholder();
    test_cross_process_layouts();
    test_wayland_publication();
    test_publication_failure();
    test_initial_group();
    test_keyboard_seat_lifecycle();
    test_notification_baseline();
    test_input_context_layout();
    test_worker_translations();
    test_worker_variant_translation();
    puts("keyboard defaults: worker translation, explicit selections, notifications, context lifetime and process isolation passed");
    return 0;
}
