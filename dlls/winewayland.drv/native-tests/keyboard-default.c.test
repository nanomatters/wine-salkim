static HWND ime_hwnd;
static HKL ime_selected;
static HKL ime_previous;
static unsigned int ime_messages;
static HWND focus_hwnd;
static HKL lang_change_hkl;
static unsigned int lang_changes;
static HWND get_default_ime_window(HWND hwnd) { return ime_hwnd; }
static HWND get_focus(void) { return focus_hwnd; }
static DWORD get_window_thread(HWND hwnd, void *process) { return GetCurrentThreadId(); }
static HKL WINAPI NtUserGetKeyboardLayout(DWORD thread_id);
static void send_message(HWND hwnd, UINT message, uintptr_t wparam, LPARAM lparam)
{
    if (message == WM_INPUTLANGCHANGE)
    {
        assert(hwnd == focus_hwnd && wparam == 1252);
        lang_change_hkl = (HKL)lparam;
        lang_changes++;
        return;
    }
    assert(hwnd == ime_hwnd && message == WM_IME_INTERNAL);
    if (wparam == IME_INTERNAL_HKL_DEACTIVATE)
    {
        assert(ime_selected);
        assert((HKL)lparam == ime_previous);
        ime_selected = NULL;
    }
    else
    {
        assert(wparam == IME_INTERNAL_HKL_ACTIVATE && !ime_selected);
        ime_selected = NtUserGetKeyboardLayout(0);
        assert((HKL)lparam == ime_selected);
    }
    ime_messages++;
}
static BOOL set_default_keyboard_layout(HKL layout);
static BOOL activate_keyboard_layout(HKL layout, UINT flags)
{
    ime_previous = NtUserGetKeyboardLayout(0);
    if (driver_default) assert(set_default_keyboard_layout(driver_default));
    return !activation_failure;
}
static UINT map_virtual_key(UINT code, UINT type, HKL layout) { return -1; }
static INT get_key_name(LONG lparam, WCHAR *name, INT size) { return -1; }
static INT to_unicode(UINT virt, UINT scan, const BYTE *state, WCHAR *str,
                       INT size, UINT flags, HKL layout) { return -2; }
