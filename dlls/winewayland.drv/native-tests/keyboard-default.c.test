/* A tiny registry with the same KLIDs Wine installs for ordinary German/US. */
typedef struct { ULONG NameLength; WCHAR Name[KL_NAMELENGTH]; } KEY_NODE_INFORMATION;
typedef struct { ULONG Type; unsigned char Data[32]; } KEY_VALUE_PARTIAL_INFORMATION;
#define KeyNodeInformation 1
#define REG_SZ 1
static const WCHAR keyboard_layouts_keyW[] = {'K',0};
static void asciiz_to_unicode(WCHAR *dst, const char *src)
{
    do { *dst++ = (unsigned char)*src; } while (*src++);
}
static unsigned long wide_to_ulong(const WCHAR *str, WCHAR **end, int base)
{
    char buffer[64];
    unsigned int i;
    for (i = 0; str[i] && i < sizeof(buffer) - 1; i++) buffer[i] = str[i];
    buffer[i] = 0;
    return strtoul(buffer, NULL, base);
}
#define wcstoul wide_to_ulong
static unsigned int wide_length(const WCHAR *str)
{
    unsigned int i = 0;
    while (str[i]) i++;
    return i;
}
#define wcslen wide_length
static WCHAR *lstrcpynW(WCHAR *dst, const WCHAR *src, int count)
{
    int i;
    for (i = 0; i < count - 1 && src[i]; i++) dst[i] = src[i];
    dst[i] = 0;
    return dst;
}
static HKEY reg_open_key(HKEY root, const WCHAR *name, unsigned int bytes)
{
    return root ? (HKEY)2 : (HKEY)1;
}
static int NtEnumerateKey(HKEY key, ULONG index, int type, KEY_NODE_INFORMATION *info,
                          unsigned int size, ULONG *length)
{
    static const char *names[] = {"00000409", "00000407"};
    registry_enumerations++;
    if (index >= 2) return 1;
    asciiz_to_unicode(info->Name, names[index]);
    *length = sizeof(*info);
    info->NameLength = 8 * sizeof(WCHAR);
    return 0;
}
static BOOL query_reg_ascii_value(HKEY key, const char *name,
                                  KEY_VALUE_PARTIAL_INFORMATION *value, unsigned int size) { return FALSE; }
static int NtClose(HKEY key) { return 0; }

