    INT (*pToUnicodeEx)(UINT, UINT, const BYTE *, WCHAR *, INT, UINT, HKL);
    const KBDTABLES *(*pKbdLayerDescriptor)(HKL);
    void (*pReleaseKbdTables)(const KBDTABLES *);
} driver = {activate_keyboard_layout, map_virtual_key, get_key_name, to_unicode,
            WAYLAND_KbdLayerDescriptor, WAYLAND_ReleaseKbdTables};
