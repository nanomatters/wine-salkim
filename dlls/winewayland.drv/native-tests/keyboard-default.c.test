struct imc { DWORD thread_id; UINT_PTR client_ptr; };
static unsigned int imc_handles;
static BOOL handle_failure;
static HIMC alloc_user_handle(struct imc *imc, UINT type)
{
    assert(type == NTUSER_OBJ_IMC);
    if (handle_failure) return NULL;
    imc_handles++;
    return imc;
}
static struct imc *free_user_handle(HIMC imc, UINT type)
{
    assert(type == NTUSER_OBJ_IMC && imc_handles);
    imc_handles--;
    return imc;
}
static struct imc *get_imc_ptr(HIMC imc) { return imc; }
static void release_imc_ptr(struct imc *imc) {}

