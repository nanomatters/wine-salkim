MODULE = winewayland.drv
UNIXLIB = winewayland.so
UNIX_CFLAGS = $(DRM_CFLAGS) $(EGL_CFLAGS) $(WAYLAND_CLIENT_CFLAGS) $(WAYLAND_EGL_CFLAGS) $(XKBCOMMON_CFLAGS) $(XKBREGISTRY_CFLAGS)
UNIX_LIBS = -lwin32u $(DRM_LIBS) $(WAYLAND_CLIENT_LIBS) $(WAYLAND_EGL_LIBS) $(XKBCOMMON_LIBS) $(XKBREGISTRY_LIBS) $(PTHREAD_LIBS) -lm
IMPORTS = user32 win32u

SOURCES = \
	alpha-modifier-v1.xml \
	color-management-v1.xml \
	content-type-v1.xml \
	cursor-shape-v1.xml \
	display.c \
	dllmain.c \
	dmabuf_sync.c \
	ext-data-control-v1.xml \
	fractional-scale-v1.xml \
	generic_output_device.c \
	linux-dmabuf-unstable-v1.xml \
	linux-drm-syncobj-v1.xml \
	keyboard-shortcuts-inhibit-unstable-v1.xml \
	linux-explicit-synchronization-unstable-v1.xml \
	opengl.c \
	pointer-constraints-unstable-v1.xml \
	pointer-warp-v1.xml \
	relative-pointer-unstable-v1.xml \
	text-input-unstable-v3.xml \
	version.rc \
	viewporter.xml \
	vulkan.c \
	wayland.c \
	wayland_data_device.c \
	wayland_keyboard.c \
	wayland_output.c \
	wayland_pointer.c \
	wayland_surface.c \
	wayland_text_input.c \
	wayland_touch.c \
	waylanddrv_main.c \
	window.c \
	window_surface.c \
	wlr-data-control-unstable-v1.xml \
	wlr-layer-shell-unstable-v1.xml \
	xdg-activation-v1.xml \
	xdg-decoration-unstable-v1.xml \
	xdg-output-unstable-v1.xml \
	xdg-shell.xml \
	xdg-toplevel-icon-v1.xml \
	xdg-toplevel-tag-v1.xml
