extern NTSTATUS __wine_unix_call(unixlib_handle_t, unsigned int, void *);

static unsigned int allocation_count, fail_allocation;
static int live_allocations, live_locks;
static unsigned int close_count, duplicate_count, endpoint_count, render_release_count;
static BOOL duplicate_result = TRUE;
static HRESULT endpoint_result = S_OK, render_release_result = S_OK;
static LONG notify_refs = 1;
static pthread_barrier_t admission_barrier;
static _Thread_local BOOL wait_before_lock;
static float render_buffer[2048];

static void *test_malloc(size_t size);
static void *test_calloc(size_t count, size_t size);
static void test_free(void *ptr);
static void test_initialize_cs(CRITICAL_SECTION *cs);
static void test_delete_cs(CRITICAL_SECTION *cs);
static void test_enter_cs(CRITICAL_SECTION *cs);
static void test_leave_cs(CRITICAL_SECTION *cs);
static BOOL test_duplicate(HANDLE source_process, HANDLE source, HANDLE dest_process,
                           HANDLE *dest, DWORD access, BOOL inherit, DWORD flags);
static BOOL test_close(HANDLE handle);
static INT test_muldiv(INT value, INT numerator, INT denominator);

/* Only operating-system services are replaced. The API bodies, object types,
 * lists, reference counts, and COM vtables below are the production source. */
#define malloc test_malloc
#define calloc test_calloc
#define free test_free
#define InitializeCriticalSection test_initialize_cs
#define DeleteCriticalSection test_delete_cs
#define EnterCriticalSection test_enter_cs
#define LeaveCriticalSection test_leave_cs
#define DuplicateHandle test_duplicate
#define CloseHandle test_close
#define MulDiv test_muldiv
#define CoTaskMemFree test_free
#undef GetLastError
#define GetLastError() ERROR_ACCESS_DENIED
#undef GetCurrentProcess
#define GetCurrentProcess() ((HANDLE)(LONG_PTR)-1)
#ifndef SPATIAL_TEST_SOURCE
#define SPATIAL_TEST_SOURCE "../spatialaudio.c"
#endif
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wformat"
#pragma GCC diagnostic ignored "-Wsign-compare"
#pragma GCC diagnostic ignored "-Wunused-variable"
#include SPATIAL_TEST_SOURCE
#pragma GCC diagnostic pop
#undef malloc
#undef calloc
#undef free
#undef InitializeCriticalSection
#undef DeleteCriticalSection
#undef EnterCriticalSection
#undef LeaveCriticalSection
#undef DuplicateHandle
#undef CloseHandle
#undef MulDiv
#undef CoTaskMemFree

