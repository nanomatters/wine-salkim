#include "test.h"

static unsigned int loop_depth, control_calls, flush_calls, allocation_calls;
static int control_result;
static float last_rate_ratio;
static enum pw_stream_state test_stream_state = PW_STREAM_STATE_PAUSED;
static struct pw_buffer *process_buffer;

void pw_thread_loop_lock(struct pw_thread_loop *loop)
{
    assert(loop == pw_loop_global);
    assert(!loop_depth++);
}

void pw_thread_loop_unlock(struct pw_thread_loop *loop)
{
    assert(loop == pw_loop_global);
    assert(loop_depth-- == 1);
}

enum pw_stream_state pw_stream_get_state(struct pw_stream *stream, const char **error)
{
    assert(loop_depth == 1);
    return test_stream_state;
}

int pw_stream_set_control(struct pw_stream *stream, uint32_t id, uint32_t n_values, float *values, ...)
{
    assert(loop_depth == 1);
    assert(id == SPA_PROP_rate && n_values == 1);
    last_rate_ratio = *values;
    control_calls++;
    return control_result;
}

int pw_stream_flush(struct pw_stream *stream, bool drain)
{
    assert(loop_depth == 1);
    flush_calls++;
    return 0;
}

struct pw_buffer *pw_stream_dequeue_buffer(struct pw_stream *stream)
{
    assert(loop_depth == 1);
    return process_buffer;
}

int pw_stream_queue_buffer(struct pw_stream *stream, struct pw_buffer *buffer)
{
    assert(loop_depth == 1 && buffer == process_buffer);
    return 0;
}

NTSTATUS WINAPI NtAllocateVirtualMemory(HANDLE process, void **addr, ULONG_PTR bits,
                                        SIZE_T *size, ULONG type, ULONG protect)
{
    allocation_calls++;
    if (!(*addr = calloc(1, *size))) return STATUS_NO_MEMORY;
    return STATUS_SUCCESS;
}

NTSTATUS WINAPI NtFreeVirtualMemory(HANDLE process, void **addr, SIZE_T *size, ULONG type)
{
    free(*addr);
    *addr = NULL;
    return STATUS_SUCCESS;
}

NTSTATUS WINAPI NtQueryPerformanceCounter(LARGE_INTEGER *counter, LARGE_INTEGER *frequency)
{
    assert(!loop_depth);
    counter->QuadPart = 12345678;
    if (frequency) frequency->QuadPart = 10000000;
    return STATUS_SUCCESS;
}

static void test_format_support(void)
{
    WAVEFORMATEXTENSIBLE fmt = {0};
    struct pipewire_stream stream;
    struct is_format_supported_params params = {0};
    HRESULT hr;
    unsigned int i;
    const unsigned int rates[] = {1, 48000, 768000, INT32_MAX};

    fmt.Format.wFormatTag = WAVE_FORMAT_PCM;
    fmt.Format.nChannels = 2;
    fmt.Format.wBitsPerSample = 16;
    params.fmt_in = &fmt.Format;
    params.share = AUDCLNT_SHAREMODE_SHARED;

    for (i = 0; i < ARRAY_SIZE(rates); ++i)
    {
        fmt.Format.nSamplesPerSec = rates[i];
        hr = pipewire_info_from_waveformat(&stream, &fmt.Format);
        assert(hr == S_OK);
        assert(stream.info.rate == rates[i]);
        pipewire_is_format_supported(&params);
        assert(params.result == S_OK);
    }

    fmt.Format.nSamplesPerSec = 0;
    pipewire_is_format_supported(&params);
    assert(params.result == S_FALSE);
    fmt.Format.nSamplesPerSec = INT32_MAX + 1u;
    pipewire_is_format_supported(&params);
    assert(params.result == S_FALSE);

    fmt.Format.nSamplesPerSec = 48000;
    fmt.Format.wBitsPerSample = 20;
    pipewire_is_format_supported(&params);
    assert(params.result == S_FALSE);
    fmt.Format.wBitsPerSample = 16;
    fmt.Format.nChannels = 3;
    pipewire_is_format_supported(&params);
    assert(params.result == S_FALSE);

    fmt.Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
    fmt.Format.cbSize = sizeof(fmt) - sizeof(fmt.Format);
    fmt.Format.nChannels = 2;
    fmt.Format.wBitsPerSample = 32;
    fmt.Samples.wValidBitsPerSample = 24;
    fmt.dwChannelMask = SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT;
    fmt.SubFormat = KSDATAFORMAT_SUBTYPE_PCM;
    hr = pipewire_info_from_waveformat(&stream, &fmt.Format);
    assert(hr == S_OK);
    assert(stream.info.format == SPA_AUDIO_FORMAT_S32_LE);
    assert(stream.pcm_24_in_32);
    pipewire_is_format_supported(&params);
    assert(params.result == S_OK);

    fmt.Format.nChannels = 0;
    pipewire_is_format_supported(&params);
    assert(params.result == S_FALSE);
    fmt.Format.nChannels = SPA_AUDIO_MAX_CHANNELS + 1;
    pipewire_is_format_supported(&params);
    assert(params.result == S_FALSE);
    fmt.Format.nChannels = 2;

    fmt.Format.cbSize--;
    pipewire_is_format_supported(&params);
    assert(params.result == S_FALSE);
    fmt.Format.cbSize++;
    fmt.Samples.wValidBitsPerSample = 33;
    pipewire_is_format_supported(&params);
    assert(params.result == S_FALSE);

    params.share = AUDCLNT_SHAREMODE_EXCLUSIVE;
    pipewire_is_format_supported(&params);
    assert(params.result == AUDCLNT_E_EXCLUSIVE_MODE_NOT_ALLOWED);
}

static void test_sample_rate(void)
{
    BYTE buffer[64], saved[64];
    struct pipewire_stream stream = {0};
    struct set_sample_rate_params params = {0};
    unsigned int i;

    for (i = 0; i < sizeof(buffer); ++i)
        buffer[i] = i;
    memcpy(saved, buffer, sizeof(saved));
    pw_loop_global = (void *)1;
    stream.pw = (void *)2;
    stream.dataflow = eRender;
    stream.info.rate = stream.rate_connected = 48000;
    stream.info.format = SPA_AUDIO_FORMAT_S16_LE;
    stream.frame_size = 4;
    stream.local_buffer = buffer;
    stream.real_bufsize_bytes = sizeof(buffer);
    stream.mmdev_period_usec = 10000;
    stream.period_bytes = 1920;
    stream.pa_offs_bytes = 8;
    stream.lcl_offs_bytes = 4;
    stream.pa_held_bytes = 12;
    stream.held_bytes = 16;
    stream.clock_written = 200;
    stream.clock_lastpos = 180;
    stream.locked = 8;
    params.stream = (UINT_PTR)&stream;
    params.rate = 24000;

    pipewire_set_sample_rate(&params);
    assert(params.result == S_OK && !loop_depth);
    assert(control_calls == 1 && !flush_calls);
    assert(last_rate_ratio == 0.5f);
    assert(stream.info.rate == 24000 && stream.period_bytes == 960);
    assert(stream.locked == 8 && stream.local_buffer == buffer);
    assert(stream.pa_offs_bytes == 8 && stream.lcl_offs_bytes == 4);
    assert(stream.pa_held_bytes == 12 && stream.held_bytes == 16);
    assert(stream.clock_written == 200 && stream.clock_lastpos == 180);
    assert(!memcmp(buffer, saved, sizeof(buffer)));

    control_result = -ENOTSUP;
    params.rate = 48000;
    pipewire_set_sample_rate(&params);
    assert(params.result == E_NOTIMPL && !loop_depth);
    assert(control_calls == 2 && !flush_calls);
    assert(stream.info.rate == 24000 && stream.period_bytes == 960);
    assert(stream.locked == 8 && stream.local_buffer == buffer);
    assert(stream.pa_offs_bytes == 8 && stream.lcl_offs_bytes == 4);
    assert(stream.pa_held_bytes == 12 && stream.held_bytes == 16);
    assert(stream.clock_written == 200 && stream.clock_lastpos == 180);
    assert(!memcmp(buffer, saved, sizeof(buffer)));

    control_result = 0;
    params.rate = 0;
    pipewire_set_sample_rate(&params);
    assert(FAILED(params.result) && !loop_depth);
    assert(control_calls == 2);
}

static void test_clock_frequency(void)
{
    const float rates[] = {24000, 96000, 48000};
    struct pipewire_stream stream = {0};
    struct set_sample_rate_params rate = {0};
    struct get_frequency_params frequency = {0};
    struct get_position_params position = {0};
    UINT64 freq, pos, qpc;
    unsigned int i;

    pw_loop_global = (void *)1;
    test_stream_state = PW_STREAM_STATE_PAUSED;
    control_calls = flush_calls = 0;
    control_result = 0;
    stream.pw = (void *)2;
    stream.dataflow = eRender;
    stream.share = AUDCLNT_SHAREMODE_SHARED;
    stream.flags = AUDCLNT_STREAMFLAGS_RATEADJUST;
    stream.info.rate = stream.rate_connected = 48000;
    stream.frame_size = 4;
    stream.mmdev_period_usec = 10000;
    stream.period_bytes = 1920;
    stream.held_bytes = 16;
    stream.clock_written = 192016;
    stream.clock_lastpos = 192000;
    rate.stream = frequency.stream = position.stream = (UINT_PTR)&stream;
    frequency.freq = &freq;
    position.pos = &pos;
    position.qpctime = &qpc;

    pipewire_get_frequency(&frequency);
    pipewire_get_position(&position);
    assert(frequency.result == S_OK && freq == 192000);
    assert(position.result == S_OK && pos == 192000 && qpc == 12345678);
    assert(pos / freq == 1 && !loop_depth);

    for (i = 0; i < ARRAY_SIZE(rates); ++i)
    {
        rate.rate = rates[i];
        pipewire_set_sample_rate(&rate);
        assert(rate.result == S_OK && stream.info.rate == rates[i]);
        assert(stream.rate_connected == 48000 && !flush_calls);
        pipewire_get_frequency(&frequency);
        pipewire_get_position(&position);
        /* No frames moved: a new playback rate must not rescale elapsed position. */
        assert(frequency.result == S_OK && freq == 192000);
        assert(position.result == S_OK && pos == 192000 && pos / freq == 1);
        assert(stream.clock_written == 192016 && stream.clock_lastpos == 192000);
        assert(!loop_depth);
    }

    control_result = -ENOTSUP;
    rate.rate = 32000;
    pipewire_set_sample_rate(&rate);
    assert(rate.result == E_NOTIMPL && stream.info.rate == 48000);
    pipewire_get_frequency(&frequency);
    assert(frequency.result == S_OK && freq == 192000 && !loop_depth);
    control_result = 0;

    stream.dataflow = eCapture;
    stream.capture_written = 192000;
    pipewire_get_frequency(&frequency);
    pipewire_get_position(&position);
    assert(frequency.result == S_OK && freq == 192000);
    assert(position.result == S_OK && pos == 192000 && !loop_depth);

    /* Exclusive clocks use frames rather than shared-mode byte positions. */
    stream.share = AUDCLNT_SHAREMODE_EXCLUSIVE;
    pipewire_get_frequency(&frequency);
    pipewire_get_position(&position);
    assert(frequency.result == S_OK && freq == 48000);
    assert(position.result == S_OK && pos == 48000 && pos / freq == 1);
    assert(stream.clock_lastpos == 192000 && !loop_depth);

    test_stream_state = PW_STREAM_STATE_ERROR;
    freq = pos = 0xdeadbeef;
    pipewire_get_frequency(&frequency);
    pipewire_get_position(&position);
    assert(frequency.result == AUDCLNT_E_DEVICE_INVALIDATED && freq == 0xdeadbeef);
    assert(position.result == AUDCLNT_E_DEVICE_INVALIDATED && pos == 0xdeadbeef);
    assert(!loop_depth);
    test_stream_state = PW_STREAM_STATE_PAUSED;
}

static void test_next_packet(void)
{
    struct pipewire_stream stream = {0};
    struct get_next_packet_size_params params = {0};
    ACPacket packet = {0};
    UINT32 frames;

    pw_loop_global = (void *)1;
    stream.pw = (void *)2;
    stream.frame_size = 4;
    stream.period_bytes = 1920;
    list_init(&stream.packet_filled_head);
    list_add_tail(&stream.packet_filled_head, &packet.entry);
    params.stream = (UINT_PTR)&stream;
    params.frames = &frames;

    test_stream_state = PW_STREAM_STATE_ERROR;
    frames = 0xdeadbeef;
    pipewire_get_next_packet_size(&params);
    assert(params.result == AUDCLNT_E_DEVICE_INVALIDATED && !loop_depth);
    assert(frames == 0xdeadbeef && !stream.locked_ptr);
    assert(list_head(&stream.packet_filled_head) == &packet.entry);

    test_stream_state = PW_STREAM_STATE_PAUSED;
    pipewire_get_next_packet_size(&params);
    assert(params.result == S_OK && frames == 480 && !loop_depth);
    assert(stream.locked_ptr == &packet && list_empty(&stream.packet_filled_head));

    stream.locked_ptr = NULL;
    pipewire_get_next_packet_size(&params);
    assert(params.result == S_OK && !frames && !loop_depth);
}

static void test_packet_alignment(void)
{
    const SIZE_T bytes[] = {0, 1, 3, 396, 1188, 2049};
    SIZE_T offset;
    unsigned int i;

    for (i = 0; i < ARRAY_SIZE(bytes); ++i)
    {
        assert(capture_packet_offset(bytes[i], &offset));
        assert(offset >= bytes[i] && offset - bytes[i] < TYPE_ALIGNMENT(ACPacket));
        assert(!(offset % TYPE_ALIGNMENT(ACPacket)));
    }
    assert(capture_packet_offset(SIZE_MAX - TYPE_ALIGNMENT(ACPacket) + 1, &offset));
    assert(!capture_packet_offset(SIZE_MAX - TYPE_ALIGNMENT(ACPacket) + 2, &offset));
    assert(!capture_packet_offset(SIZE_MAX, &offset));
}

static void test_buffer_sizes(void)
{
    struct pipewire_stream stream = {0};
    SIZE_T size, offset, bytes;

    stream.dataflow = eRender;
    stream.info.rate = 48000;
    stream.frame_size = 4;
    stream.period_bytes = 1920;
    stream.duration = 300000;
    assert(calc_buffer_size(&stream, &size, &offset));
    assert(stream.bufsize_frames == 1440 && stream.real_bufsize_bytes == 11520);
    assert(size == 11520 && !offset);

    stream.dataflow = eCapture;
    assert(calc_buffer_size(&stream, &size, &offset));
    assert(stream.bufsize_frames == 1440 && stream.real_bufsize_bytes == 5760);
    assert(offset == 5760 && size == 5760 + 3 * sizeof(ACPacket));

    stream.info.rate = 44100;
    stream.frame_size = 3;
    stream.period_bytes = 396;
    assert(calc_buffer_size(&stream, &size, &offset));
    assert(stream.bufsize_frames == 1452 && stream.real_bufsize_bytes == 4356);
    assert(offset >= 4356 && !(offset % TYPE_ALIGNMENT(ACPacket)));
    assert(size == offset + 11 * sizeof(ACPacket));

    stream.duration = 0;
    assert(!calc_buffer_size(&stream, &size, &offset));
    stream.duration = -1;
    assert(!calc_buffer_size(&stream, &size, &offset));
    stream.duration = INT64_MAX;
    assert(!calc_buffer_size(&stream, &size, &offset));

    stream.dataflow = eRender;
    stream.info.rate = 1;
    stream.frame_size = stream.period_bytes = 1;
    stream.duration = (UINT64)(UINT32_MAX / 2) * 10000000;
    assert(calc_buffer_size(&stream, &size, &offset));
    assert(stream.real_bufsize_bytes == UINT32_MAX - 1u);
    stream.duration += 10000000;
    assert(!calc_buffer_size(&stream, &size, &offset));

    stream.dataflow = eCapture;
    stream.duration = ((UINT64)UINT32_MAX + 1) * 10000000;
    assert(!calc_buffer_size(&stream, &size, &offset));
    stream.duration = (UINT64)(UINT32_MAX / sizeof(ACPacket) + 1) * 10000000;
    if (SIZE_MAX == UINT32_MAX) assert(!calc_buffer_size(&stream, &size, &offset));
    else assert(calc_buffer_size(&stream, &size, &offset));

    /* Duration fits UINT64 arithmetic, but the frame byte count does not
     * fit the UINT32-sized callback and ring operations. */
    stream.duration = (UINT64)UINT32_MAX * 10000000;
    stream.frame_size = stream.period_bytes = 256;
    assert(!calc_buffer_size(&stream, &size, &offset));

    assert(calc_period_bytes(30000, 44100, 10000000, 3, &bytes) && bytes == 396);
    assert(!calc_period_bytes(UINT64_MAX, 48000, 10000000, 4, &bytes));
    assert(!calc_period_bytes(100000, 0, 10000000, 4, &bytes));
    assert(!calc_period_bytes(1, 1, 10000000, 4, &bytes));
}

static void test_render_bounds(void)
{
    struct pipewire_stream stream = {0};
    struct get_render_buffer_params params = {0};
    struct release_render_buffer_params release = {0};
    BYTE buffer[64], *data;

    pw_loop_global = (void *)1;
    stream.pw = (void *)2;
    stream.dataflow = eRender;
    stream.info.format = SPA_AUDIO_FORMAT_S16_LE;
    stream.frame_size = 4;
    stream.bufsize_frames = 8;
    stream.real_bufsize_bytes = sizeof(buffer);
    stream.local_buffer = buffer;
    stream.held_bytes = 4;
    params.stream = release.stream = (UINT_PTR)&stream;
    params.data = &data;
    params.frames = UINT32_MAX;
    data = (void *)3;

    pipewire_get_render_buffer(&params);
    assert(params.result == AUDCLNT_E_BUFFER_TOO_LARGE && !loop_depth);
    assert(data == (void *)3 && !stream.locked && !allocation_calls);

    params.frames = 8;
    pipewire_get_render_buffer(&params);
    assert(params.result == AUDCLNT_E_BUFFER_TOO_LARGE && !loop_depth);
    params.frames = 7;
    pipewire_get_render_buffer(&params);
    assert(params.result == S_OK && !loop_depth);
    assert(data == buffer + 4 && stream.locked == 28 && !allocation_calls);
    stream.locked = 0;

    /* Exercise a wrapped acquisition and its actual release. */
    stream.lcl_offs_bytes = 60;
    stream.held_bytes = stream.pa_held_bytes = 0;
    params.frames = 2;
    pipewire_get_render_buffer(&params);
    assert(params.result == S_OK && !loop_depth);
    assert(data == stream.tmp_buffer && stream.locked == -8);
    assert(allocation_calls == 1);
    memset(data, 0x5a, 8);
    release.written_frames = 2;
    pipewire_release_render_buffer(&release);
    assert(release.result == S_OK && !stream.locked && !loop_depth);
    assert(stream.held_bytes == 8 && stream.pa_held_bytes == 8);
    assert(!memcmp(buffer + 60, "ZZZZ", 4) && !memcmp(buffer, "ZZZZ", 4));
    free(stream.tmp_buffer);

    /* Both operands fit UINT32, but their sum does not on native i386. */
    stream.tmp_buffer = NULL;
    stream.tmp_buffer_bytes = 0;
    stream.real_bufsize_bytes = UINT32_MAX - 1u;
    stream.bufsize_frames = stream.real_bufsize_bytes / 8;
    stream.lcl_offs_bytes = UINT32_MAX - 3u;
    stream.held_bytes = 8;
    params.frames = 1;
    pipewire_get_render_buffer(&params);
    assert(params.result == S_OK && data == buffer + 6 && stream.locked == 4);
    assert(!loop_depth && allocation_calls == 1);

    stream.pa_held_bytes = stream.real_bufsize_bytes - 1;
    release.written_frames = 1;
    pipewire_release_render_buffer(&release);
    assert(release.result == S_OK && !stream.locked && !loop_depth);
    assert(stream.pa_held_bytes == stream.held_bytes && stream.held_bytes == 12);
    assert(stream.pa_offs_bytes == stream.lcl_offs_bytes);
}

static void test_capture_offset(void)
{
    BYTE ring[64] = {0}, input[] = {1, 2, 3, 4};
    struct spa_chunk chunk = {.size = sizeof(input)};
    struct spa_data data = {.data = input, .maxsize = sizeof(input), .chunk = &chunk};
    struct spa_buffer buffer = {.n_datas = 1, .datas = &data};
    struct pw_buffer pw_buffer = {.buffer = &buffer};
    struct pipewire_stream stream = {0};

    pw_loop_global = (void *)1;
    stream.dataflow = eCapture;
    stream.frame_size = 4;
    stream.started = TRUE;
    stream.capture_ring = ring;
    stream.capture_ring_size = UINT32_MAX - 1u;
    stream.cap_read_offs = UINT32_MAX - 3u;
    stream.cap_held_bytes = 8;
    process_buffer = &pw_buffer;

    pw_thread_loop_lock(pw_loop_global);
    on_stream_process(&stream);
    pw_thread_loop_unlock(pw_loop_global);
    assert(!memcmp(ring + 6, input, sizeof(input)));
    assert(stream.cap_held_bytes == 12 && stream.capture_written == sizeof(input));
    assert(!stream.overrun_count && !loop_depth);
}

int main(int argc, char **argv)
{
    assert(argc <= 2);
    if (argc == 1 || !strcmp(argv[1], "format")) test_format_support();
    if (argc == 1 || !strcmp(argv[1], "rate")) test_sample_rate();
    if (argc == 1 || !strcmp(argv[1], "clock")) test_clock_frequency();
    if (argc == 1 || !strcmp(argv[1], "packet")) test_next_packet();
    if (argc == 1 || !strcmp(argv[1], "alignment")) test_packet_alignment();
    if (argc == 1 || !strcmp(argv[1], "sizes")) test_buffer_sizes();
    if (argc == 1 || !strcmp(argv[1], "render")) test_render_bounds();
    if (argc == 1 || !strcmp(argv[1], "capture")) test_capture_offset();
    puts("PipeWire stream tests passed");
    return 0;
}
