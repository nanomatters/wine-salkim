#define pw_proxy_destroy test_proxy_destroy
#include "test.h"

static unsigned int destroyed;

void test_proxy_destroy(struct pw_proxy *proxy)
{
    assert(proxy);
    ++destroyed;
}

DWORD ntdll_umbstowcs(const char *src, DWORD srclen, WCHAR *dst, DWORD dstlen)
{
    DWORD i, count = min(srclen, dstlen);

    for (i = 0; i < count; ++i)
    {
        assert((unsigned char)src[i] < 0x80);
        dst[i] = src[i];
    }
    return count;
}

static void test_defaults(void)
{
    struct probe probe = {0};
    char json[512];
    unsigned int i;

    json[0] = '{';
    json[1] = '"';
    for (i = 2; i < 202; ++i) json[i] = 'x';
    strcpy(json + i, "\":{\"nested\":[1,2]},\"name\":\"sink\"}");
    on_probe_metadata_property(&probe, PW_ID_CORE, "default.audio.sink", NULL, json);
    assert(!strcmp(probe.default_sink, "sink"));
    on_probe_metadata_property(&probe, PW_ID_CORE, "default.audio.source", NULL, "{\"name\":\"source\"}");
    assert(!strcmp(probe.default_source, "source"));

    on_probe_metadata_property(&probe, PW_ID_CORE, "default.audio.sink", NULL, "{\"other\":\"sink\"}");
    assert(!probe.default_sink[0] && !strcmp(probe.default_source, "source"));
    on_probe_metadata_property(&probe, PW_ID_CORE, "default.audio.source", NULL, NULL);
    assert(!probe.default_source[0]);

    on_probe_metadata_property(&probe, PW_ID_CORE, "default.audio.sink", NULL, "{\"name\":\"sink\"}");
    on_probe_metadata_property(&probe, PW_ID_CORE, "default.audio.sink", NULL, "{\"name\":123}");
    assert(!probe.default_sink[0]);
    on_probe_metadata_property(&probe, PW_ID_CORE, "default.audio.sink", NULL, "{\"name\":\"sink\"");
    assert(!probe.default_sink[0]);
    on_probe_metadata_property(&probe, PW_ID_CORE, "default.audio.sink", NULL, "{\"name\":\"sink\"} {}");
    assert(!probe.default_sink[0]);

    on_probe_metadata_property(&probe, PW_ID_CORE, "default.audio.sink", NULL, "{\"name\":\"sink\"}");
    on_probe_metadata_property(&probe, 1, "default.audio.sink", NULL, NULL);
    assert(!strcmp(probe.default_sink, "sink"));
    on_probe_metadata_property(&probe, PW_ID_CORE, NULL, NULL, NULL);
    assert(!probe.default_sink[0] && !probe.default_source[0]);

    json[0] = '{';
    strcpy(json + 1, "\"name\":\"");
    memset(json + 9, 'x', 300);
    strcpy(json + 309, "\"}");
    on_probe_metadata_property(&probe, PW_ID_CORE, "default.audio.sink", NULL, json);
    assert(!probe.default_sink[0]);
}

static void test_settings(void)
{
    static const char *bad_values[] = {"", "-1", "+48000", " 48000", "48000 ", "48000Hz",
                                       "2147483648", "4294967296", "18446744073709551616", "0x100", NULL};
    struct probe probe = {0};
    uint32_t rate;
    REFERENCE_TIME def, minimum;
    WAVEFORMATEXTENSIBLE format = {0};
    unsigned int i;

    get_probe_periods(&probe, &rate, &def, &minimum);
    assert(rate == 48000 && def == 100000 && minimum == 30000);

    /* Stock graph defaults must not raise Wine's shared default or lower
     * its 128-frame floor. An explicit graph minimum remains authoritative. */
    on_probe_settings_property(&probe, 0, "clock.rate", NULL, "48000");
    on_probe_settings_property(&probe, 0, "clock.quantum", NULL, "1024");
    on_probe_settings_property(&probe, 0, "clock.min-quantum", NULL, "32");
    assert(get_probe_periods(&probe, &rate, &def, &minimum));
    assert(rate == 48000 && def == 100000 && minimum == 26666);
    assert((minimum * rate + 9999999) / 10000000 == 128);
    on_probe_settings_property(&probe, 0, "clock.force-quantum", NULL, "256");
    assert(get_probe_periods(&probe, &rate, &def, &minimum));
    assert(def == 100000 && minimum == 53333);
    on_probe_settings_property(&probe, 0, "clock.force-quantum", NULL, "32");
    assert(get_probe_periods(&probe, &rate, &def, &minimum));
    assert(def == 100000 && minimum == 26666);
    on_probe_settings_property(&probe, 0, NULL, NULL, NULL);

    on_probe_settings_property(&probe, 0, "clock.force-rate", NULL, "96000");
    on_probe_settings_property(&probe, 0, "clock.rate", NULL, "48000");
    on_probe_settings_property(&probe, 0, "clock.force-quantum", NULL, "1024");
    on_probe_settings_property(&probe, 0, "clock.min-quantum", NULL, "4096");
    on_probe_settings_property(&probe, 0, "clock.quantum", NULL, "512");
    get_probe_periods(&probe, &rate, &def, &minimum);
    assert(rate == 96000 && def == 106666 && minimum == def);
    assert((minimum * rate + 9999999) / 10000000 == 1024);
    {
        struct probe reverse = {0};
        uint32_t reverse_rate;
        REFERENCE_TIME reverse_def, reverse_min;

        on_probe_settings_property(&reverse, 0, "clock.quantum", NULL, "512");
        on_probe_settings_property(&reverse, 0, "clock.min-quantum", NULL, "4096");
        on_probe_settings_property(&reverse, 0, "clock.rate", NULL, "48000");
        on_probe_settings_property(&reverse, 0, "clock.force-quantum", NULL, "1024");
        on_probe_settings_property(&reverse, 0, "clock.force-rate", NULL, "96000");
        get_probe_periods(&reverse, &reverse_rate, &reverse_def, &reverse_min);
        assert(rate == reverse_rate && def == reverse_def && minimum == reverse_min);
    }

    on_probe_settings_property(&probe, 0, "clock.force-quantum", NULL, "0");
    on_probe_settings_property(&probe, 0, "clock.force-rate", NULL, NULL);
    get_probe_periods(&probe, &rate, &def, &minimum);
    assert(rate == 48000 && minimum == 853333 && def == minimum);
    on_probe_settings_property(&probe, 0, "clock.min-quantum", NULL, "128");
    get_probe_periods(&probe, &rate, &def, &minimum);
    assert(minimum == 26666 && def == 100000);

    for (i = 0; i < ARRAY_SIZE(bad_values); ++i)
    {
        on_probe_settings_property(&probe, 0, "clock.force-rate", NULL, "96000");
        on_probe_settings_property(&probe, 0, "clock.force-rate", NULL, bad_values[i]);
        assert(!probe.force_rate && probe.clock_rate == 48000);
    }
    on_probe_settings_property(&probe, 1, "clock.rate", NULL, "96000");
    assert(probe.clock_rate == 48000);

    on_probe_settings_property(&probe, 0, "clock.rate", NULL, "1");
    on_probe_settings_property(&probe, 0, "clock.force-quantum", NULL, "4294967295");
    get_probe_periods(&probe, &rate, &def, &minimum);
    assert(rate == 1 && minimum == (REFERENCE_TIME)UINT32_MAX * 10000000 && def == minimum);
    on_probe_settings_property(&probe, 0, "clock.rate", NULL, "2147483647");
    on_probe_settings_property(&probe, 0, "clock.force-quantum", NULL, "1");
    get_probe_periods(&probe, &rate, &def, &minimum);
    assert(minimum == 1 && def == 100000);
    assert(quantum_to_period(513, 20000000, &minimum) && minimum == 257);
    assert((minimum * 20000000 + 9999999) / 10000000 >= 513);
    assert(!quantum_to_period(UINT32_MAX, 20000000, &minimum));
    on_probe_settings_property(&probe, 0, NULL, NULL, NULL);
    assert(!probe.clock_rate && !probe.force_rate && !probe.min_quantum && !probe.force_quantum);

    assert(build_format(&format, 48000, 8, KSAUDIO_SPEAKER_7POINT1_SURROUND));
    assert(format.Format.nAvgBytesPerSec == 48000 * 32);
    assert(build_format(&format, UINT32_MAX / 4, 1, SPEAKER_FRONT_CENTER));
    assert(!build_format(&format, UINT32_MAX, 2, KSAUDIO_SPEAKER_STEREO));
}

static void test_node_removal(void)
{
    struct pw_registry_methods methods = {PW_VERSION_REGISTRY_METHODS};
    struct spa_interface registry = SPA_INTERFACE_INIT(PW_TYPE_INTERFACE_Registry, PW_VERSION_REGISTRY, &methods, NULL);
    struct spa_dict_item items[] = {{PW_KEY_MEDIA_CLASS, "Audio/Sink"}, {PW_KEY_NODE_NAME, ""}};
    struct spa_dict properties = SPA_DICT_INIT_ARRAY(items);
    struct probe probe = {.registry = (void *)&registry};
    struct probe_node *node;

    list_init(&probe.nodes);
    list_init(&probe.devices);
    on_probe_registry_global(&probe, 1, 0, PW_TYPE_INTERFACE_Node, PW_VERSION_NODE, &properties);
    assert(list_empty(&probe.nodes));
    items[1].value = "sink";
    on_probe_registry_global(&probe, 1, 0, PW_TYPE_INTERFACE_Node, PW_VERSION_NODE, &properties);
    on_probe_registry_global(&probe, 2, 0, PW_TYPE_INTERFACE_Node, PW_VERSION_NODE, &properties);
    assert(list_count(&probe.nodes) == 2);
    node = LIST_ENTRY(list_head(&probe.nodes), struct probe_node, entry);
    node->proxy = (void *)1;
    spa_list_init(&node->listener.link);
    on_probe_registry_global_remove(&probe, 1);
    assert(destroyed == 1 && list_count(&probe.nodes) == 1);
    node = LIST_ENTRY(list_head(&probe.nodes), struct probe_node, entry);
    assert(node->id == 2);
    on_probe_registry_global_remove(&probe, 99);
    assert(list_count(&probe.nodes) == 1);
    on_probe_registry_global_remove(&probe, 2);
    assert(list_empty(&probe.nodes));

    probe.meta_default = (void *)1;
    probe.meta_settings = (void *)2;
    probe.meta_default_id = 10;
    probe.meta_settings_id = 11;
    spa_list_init(&probe.meta_default_listener.link);
    spa_list_init(&probe.meta_settings_listener.link);
    strcpy(probe.default_sink, "sink");
    probe.force_rate = 96000;
    on_probe_registry_global_remove(&probe, 10);
    assert(!probe.meta_default && !probe.default_sink[0] && probe.meta_settings);
    on_probe_registry_global_remove(&probe, 11);
    assert(!probe.meta_settings && !probe.force_rate && destroyed == 3);
}

static void test_duplicate_names(void)
{
    struct pw_phys_device *render, *capture;

    render = add_device(&g_render_devices, "same", "Speakers", Speakers, 48000, 2,
                        KSAUDIO_SPEAKER_STEREO, 100000, 30000);
    assert(render);
    assert(!add_device(&g_render_devices, "same", "Duplicate", Speakers, 48000, 2,
                       KSAUDIO_SPEAKER_STEREO, 100000, 30000));
    capture = add_device(&g_capture_devices, "same", "Microphone", Microphone, 48000, 2,
                         KSAUDIO_SPEAKER_STEREO, 100000, 30000);
    assert(capture && list_count(&g_render_devices) == 1 && list_count(&g_capture_devices) == 1);
    assert(render->fmt.Format.nAvgBytesPerSec == 48000 * 8);
    assert(render->def_period == 100000 && render->min_period == 30000);
    free_device_lists();
    assert(list_empty(&g_render_devices) && list_empty(&g_capture_devices));
}

static void test_invalid_cache_format(void)
{
    struct probe probe = {.clock_rate = INT32_MAX};

    list_init(&probe.nodes);
    list_init(&probe.devices);
    build_device_cache(&probe);
    assert(list_empty(&g_render_devices) && list_empty(&g_capture_devices));

    probe.clock_rate = 48000;
    build_device_cache(&probe);
    assert(list_count(&g_render_devices) == 1 && list_count(&g_capture_devices) == 1);
    free_device_lists();

    probe.clock_rate = 20000000;
    probe.force_quantum = UINT32_MAX;
    build_device_cache(&probe);
    assert(list_empty(&g_render_devices) && list_empty(&g_capture_devices));
}

int main(void)
{
    test_defaults();
    test_settings();
    test_node_removal();
    test_duplicate_names();
    test_invalid_cache_format();
    puts("PipeWire probe tests passed");
    return 0;
}
