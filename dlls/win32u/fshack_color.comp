#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D texSampler;
layout(binding = 1) uniform writeonly image2D outImage;

layout(push_constant) uniform pushConstants
{
    vec2 offset;
    vec2 extents;
    uint transfer;
    uint linear_filter;
} constants;

vec3 pq_to_linear(vec3 value)
{
    const float m1 = 2610.0 / 16384.0;
    const float m2 = 2523.0 / 32.0;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = 2413.0 / 128.0;
    const float c3 = 2392.0 / 128.0;
    vec3 p = pow(clamp(value, 0.0, 1.0), vec3(1.0 / m2));

    return pow(max(p - c1, 0.0) / max(c2 - c3 * p, 1e-6), vec3(1.0 / m1));
}

vec3 linear_to_pq(vec3 value)
{
    const float m1 = 2610.0 / 16384.0;
    const float m2 = 2523.0 / 32.0;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = 2413.0 / 128.0;
    const float c3 = 2392.0 / 128.0;
    vec3 p = pow(max(value, 0.0), vec3(m1));

    return pow((c1 + c2 * p) / (1.0 + c3 * p), vec3(m2));
}

vec3 hlg_to_linear(vec3 value)
{
    const float a = 0.17883277;
    const float b = 0.28466892;
    const float c = 0.55991073;
    bvec3 low = lessThanEqual(value, vec3(0.5));
    vec3 low_value = value * value / 3.0;
    vec3 high_value = (exp((value - c) / a) + b) / 12.0;

    return mix(high_value, low_value, low);
}

vec3 linear_to_hlg(vec3 value)
{
    const float a = 0.17883277;
    const float b = 0.28466892;
    const float c = 0.55991073;
    bvec3 low = lessThanEqual(value, vec3(1.0 / 12.0));
    vec3 low_value = sqrt(3.0 * max(value, 0.0));
    vec3 high_value = a * log(max(12.0 * value - b, 1e-6)) + c;

    return mix(high_value, low_value, low);
}

vec3 srgb_to_linear(vec3 value)
{
    vec3 magnitude = abs(value);
    bvec3 low = lessThanEqual(magnitude, vec3(0.04045));
    vec3 low_value = magnitude / 12.92;
    vec3 high_value = pow((magnitude + 0.055) / 1.055, vec3(2.4));

    return sign(value) * mix(high_value, low_value, low);
}

vec3 linear_to_srgb(vec3 value)
{
    vec3 magnitude = abs(value);
    bvec3 low = lessThanEqual(magnitude, vec3(0.0031308));
    vec3 low_value = magnitude * 12.92;
    vec3 high_value = 1.055 * pow(magnitude, vec3(1.0 / 2.4)) - 0.055;

    return sign(value) * mix(high_value, low_value, low);
}

vec3 to_linear(vec3 value)
{
    if (constants.transfer == 1)
        return pq_to_linear(value);
    if (constants.transfer == 2)
        return hlg_to_linear(value);
    return srgb_to_linear(value);
}

vec3 from_linear(vec3 value)
{
    if (constants.transfer == 1)
        return linear_to_pq(value);
    if (constants.transfer == 2)
        return linear_to_hlg(value);
    return linear_to_srgb(value);
}

vec4 sample_linearized(vec2 texcoord)
{
    ivec2 size = textureSize(texSampler, 0);
    vec2 source = texcoord * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(source));
    ivec2 limit = size - 1;
    vec2 weight = fract(source);
    vec4 c00 = texelFetch(texSampler, clamp(base, ivec2(0), limit), 0);
    vec4 c10 = texelFetch(texSampler, clamp(base + ivec2(1, 0), ivec2(0), limit), 0);
    vec4 c01 = texelFetch(texSampler, clamp(base + ivec2(0, 1), ivec2(0), limit), 0);
    vec4 c11 = texelFetch(texSampler, clamp(base + ivec2(1, 1), ivec2(0), limit), 0);
    vec3 top = mix(to_linear(c00.rgb), to_linear(c10.rgb), weight.x);
    vec3 bottom = mix(to_linear(c01.rgb), to_linear(c11.rgb), weight.x);
    float alpha_top = mix(c00.a, c10.a, weight.x);
    float alpha_bottom = mix(c01.a, c11.a, weight.x);

    return vec4(from_linear(mix(top, bottom, weight.y)),
                mix(alpha_top, alpha_bottom, weight.y));
}

void main()
{
    vec2 position = vec2(gl_GlobalInvocationID.xy);
    vec4 color;

    if (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), imageSize(outImage))))
        return;

    if (any(lessThan(position, constants.offset)) ||
        any(greaterThanEqual(position, constants.offset + constants.extents)))
    {
        imageStore(outImage, ivec2(gl_GlobalInvocationID.xy), vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec2 texcoord = (position - constants.offset) / constants.extents +
                    0.5 / vec2(textureSize(texSampler, 0));
    if (constants.transfer != 0 && constants.linear_filter != 0)
        color = sample_linearized(texcoord);
    else
        color = texture(texSampler, texcoord);

    imageStore(outImage, ivec2(gl_GlobalInvocationID.xy), color);
}
